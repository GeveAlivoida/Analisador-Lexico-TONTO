// Arquivo TOTALMENTE ERRADO para testes
package BandasErrado

pakage Banda                  // Erro: palavra-chave correta é package
inport Musica                 // Erro: 'inport' ao invés de import
import "Musica"               // Erro: import não aceita string

category 123Instrumento of functional-complexes, collectives {   // Erro: número ao início de nome de classe
    nome: string
    descricao: string
    eletrico: boolean
    cor: Cor
}

// Erro: caracteres inválidos
kind Instrumento&$Cordas specializes 123Instrumento
kind Instrument#oSopro% specializes 123Instrumento
kind InstrumentoPercussao007 specializes 123Instrumento

kind _Musico // Erro: nome não pode começar com '_'

relation Musico [1] -- toca_4 -- [1] 123Instrumento // Erro: nome de relação não pode ter números

123456 // Número solto